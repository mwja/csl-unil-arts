<!-- Generated from universite-de-lausanne-histoire-de-l-art.csl by scripts/build-variants.ts; do not edit by hand. -->
<style xmlns="http://purl.org/net/xbiblio/csl" class="note" version="1.0" demote-non-dropping-particle="never" page-range-format="expanded" default-locale="fr-FR">
  <info>
    <title>Université de Lausanne - Histoire de l'art (notes abrégées, Français)</title>
    <title-short>UNIL - Histoire de l'art (notes abrégées)</title-short>
    <id>http://www.zotero.org/styles/universite-de-lausanne-histoire-de-l-art-notes-abregees</id>
    <link href="http://www.zotero.org/styles/universite-de-lausanne-histoire-de-l-art-notes-abregees" rel="self"/>
